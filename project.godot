config/icon="uid://bdceqddkdbot4"

[autoload]

GlobalPlayerData="*uid://dyy8yn7d34fe0"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/snap_controls_to_pixels=false
